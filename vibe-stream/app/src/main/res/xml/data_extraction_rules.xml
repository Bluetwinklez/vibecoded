<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the device through cloud backup or device-to-device transfer. Playlists hold login data,
     and their encryption key (Android Keystore) does not travel with a transfer anyway. The app has its own backup
     (Settings > Backup), which the user starts on purpose. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
